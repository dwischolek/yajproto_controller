  (text "CHANNEL ORDER (zero based): channel = row * 5 + column" (at 114.3 236.22 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "eda8c01d-3280-45d1-a271-9880fad496b7"))
  (text "SW1..SW5 = CH0..4, SW6..SW10 = CH5..9, ... SW21..SW25 = CH20..24." (at 114.3 242.57 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "d8fe4976-e2f1-49e5-884a-9845616243ca"))
  (text "One column is driven LOW; inactive columns and all rows use MCU pull-ups." (at 114.3 248.92 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "fc7f0c13-d0a8-4fb5-b1f5-a173150f68ca"))
  (text "Diodes isolate simultaneous presses. Software debounce: 3 scans; update period: 10 ms." (at 114.3 255.27 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "dc9fdc81-ed1b-4f3d-a446-d85def453c84"))
  (text "Build assumptions" (at 12.7 238.76 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "6e4f981b-fa69-4ed9-b120-442d2b13ed08"))
  (text "A1: classic Nano v3.x, ATmega328P, 5 V / 16 MHz." (at 12.7 245.11 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "ca3720bb-2233-40e7-9493-b034ec6d8a78"))
  (text "RV and switch mechanical parts are unspecified;" (at 12.7 250.19 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "f7eb9c81-0c4a-4d1e-a21b-b51cf3a56fcb"))
  (text "choose footprints after selecting actual controls." (at 12.7 255.27 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "a0b14319-7508-4dcf-b30b-0447405156cc"))
  (text "Power the assembled module through USB only." (at 12.7 260.35 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "91ca2ddf-bb51-4b9f-b94e-efba063e3cad"))
